[Unit]
Description=Entrance bastion
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# ENTRANCE_TOKEN=<shared token> in this file (chmod 600).
EnvironmentFile=/etc/entrance/entrance.env
ExecStart=/usr/local/bin/entrance --dev=false --listen :443 \
    --hostname bastion.example.com --data-dir /var/lib/entrance
Restart=on-failure
RestartSec=3
StateDirectory=entrance

[Install]
WantedBy=multi-user.target
