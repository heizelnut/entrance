[Unit]
Description=Entrance agent (outbound-only remote shell)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# ENTRANCED_TOKEN=<shared token> in this file (chmod 600).
EnvironmentFile=/etc/entrance/entranced.env
ExecStart=/usr/local/bin/entranced --server https://bastion.example.com \
    --audit-log /var/log/entranced-audit.log
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
